# ---------- Application ----------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# ---------- PostgreSQL ----------
# Special characters in the password must be percent-encoded (@ becomes %40)
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/mekoya

# ---------- Tokens ----------
# Generate your own secret (at least 32 characters) with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app refuses to start in production while this placeholder is unchanged.
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# ---------- Seed accounts (used by: npx prisma db seed) ----------
# Demo values for LOCAL EVALUATION ONLY. Use strong, unique passwords anywhere else.
# Admin login: SEED_ADMIN_EMAIL with SEED_ADMIN_PASSWORD
# All other demo users share SEED_DEMO_PASSWORD (citizen1@mekoya.test, officer.bole@mekoya.test, ...)
SEED_ADMIN_EMAIL=admin@mekoya.test
SEED_ADMIN_PASSWORD=admin123
SEED_DEMO_PASSWORD=Demo!Pass2026

# ---------- Google sign-in (optional) ----------
# Leave empty to disable. POST /auth/google then answers 503 GOOGLE_NOT_CONFIGURED.
GOOGLE_CLIENT_ID=

# ---------- Email ----------
# Leave SMTP_HOST empty to use a free Ethereal test inbox: the server log prints a
# preview URL for every email. Set all SMTP_* values to send through a real provider.
EMAIL_FROM="Mekoya <no-reply@mekoya.test>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- File uploads ----------
UPLOAD_DIR=uploads

# ---------- AI ----------
# mock: works without credentials. The document review decides by upload file name
#       (blurry.png, wrong.png, unsure.png, fail.png) and the checklist uses keyword matching.
# gemini: needs GEMINI_API_KEY. Check Google's current model list for GEMINI_MODEL.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_REVIEW_TIMEOUT_MS=30000

# ---------- Appointment reminders ----------
ENABLE_SCHEDULER=true
REMINDER_HOURS_BEFORE=24

# false lets an officer complete a demo appointment before its time slot.
# Set to true in a real deployment.
ENFORCE_COMPLETION_TIMING=false