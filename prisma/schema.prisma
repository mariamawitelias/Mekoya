generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  EN
  AM
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  OFFICER_INVITE
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DocumentStatus {
  PENDING
  AI_APPROVED
  AI_REJECTED
  NEEDS_HUMAN
  OFFICER_APPROVED
  OFFICER_REJECTED
}

enum AiStatus {
  PENDING
  DONE
  FALLBACK
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum EmailTemplate {
  WELCOME_VERIFY
  PASSWORD_RESET
  OFFICER_INVITE
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER
  DOCUMENT_REJECTED
}



model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String? // null for Google-only accounts
  googleId      String?  @unique
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  roleId        String
  officeId      String? // set only for officers (one officer = one office)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role   Role    @relation(fields: [roleId], references: [id])
  office Office? @relation(fields: [officeId], references: [id])

  profile            Profile? // 1:1
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  appointments       Appointment[]
  reviewedDocuments  DocumentSubmission[] @relation("DocumentReviewer")
  auditLogs          AuditLog[]
  emailLogs          EmailLog[]

  @@index([roleId])
  @@index([officeId])
}

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique
  fullName          String
  phone             String?
  preferredLanguage Language @default(EN)
  avatarUrl         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // CITIZEN | OFFICER | CONTENT_ADMIN | SUPER_ADMIN
  description String?
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. "appointment:book"
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  familyId     String // all tokens descended from one login share this
  userId       String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String? // set when rotated
  userAgent    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}

model VerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  type      TokenType
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ───────────────────────── Catalog ─────────────────────────

model Office {
  id        String   @id @default(uuid())
  nameEn    String
  nameAm    String?
  addressEn String?
  addressAm String?
  city      String
  slotTimes String[] // daily fixed slots, "HH:mm" e.g. ["08:30","09:30"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  officers     User[]
  services     OfficeService[]
  appointments Appointment[]

  @@index([city])
}

model Service {
  id            String   @id @default(uuid())
  slug          String   @unique
  nameEn        String
  nameAm        String?
  descriptionEn String?
  descriptionAm String?
  category      String
  feeInfo       String? // informational only, no payments
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requirements ServiceRequirement[]
  offices      OfficeService[]
  appointments Appointment[]

  @@index([category])
  @@index([nameEn])
}

model Requirement {
  id            String   @id @default(uuid())
  nameEn        String
  nameAm        String?
  descriptionEn String?
  descriptionAm String?
  expectedType  String // hint for AI review, e.g. "PASSPORT_PHOTO", "NATIONAL_ID"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services ServiceRequirement[]
}

// Explicit M:N Service <-> Requirement with extra columns
model ServiceRequirement {
  id            String  @id @default(uuid())
  serviceId     String
  requirementId String
  isMandatory   Boolean @default(true)
  notesEn       String?
  notesAm       String?

  service     Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  requirement Requirement          @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  documents   DocumentSubmission[]

  @@unique([serviceId, requirementId])
}

// Explicit M:N Office <-> Service with capacity per slot
model OfficeService {
  officeId     String
  serviceId    String
  slotCapacity Int    @default(3)

  office  Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([officeId, serviceId])
}

// ─────────────────────── Appointments ───────────────────────

model Appointment {
  id             String            @id @default(uuid())
  userId         String
  officeId       String
  serviceId      String
  slotStart      DateTime
  status         AppointmentStatus @default(BOOKED)
  idempotencyKey String?
  closureNote    String?
  reminderSentAt DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user      User                 @relation(fields: [userId], references: [id])
  office    Office               @relation(fields: [officeId], references: [id])
  service   Service              @relation(fields: [serviceId], references: [id])
  documents DocumentSubmission[]
  emailLogs EmailLog[]

  @@unique([userId, idempotencyKey])
  @@index([officeId, serviceId, slotStart]) // capacity checks
  @@index([officeId, slotStart, status]) // officer queue
  @@index([userId, status])
  @@index([status, slotStart]) // reminder cron
}

model DocumentSubmission {
  id                   String         @id @default(uuid())
  appointmentId        String
  serviceRequirementId String
  version              Int            @default(1)
  isCurrent            Boolean        @default(true) // old versions kept as history
  filePath             String
  originalName         String
  mimeType             String
  sizeBytes            Int
  status               DocumentStatus @default(PENDING)
  rejectionReason      String?
  aiStatus             AiStatus       @default(PENDING)
  aiResult             Json? // raw structured output from the model
  aiConfidence         Float?
  appealRequested      Boolean        @default(false)
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNote           String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  appointment        Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceRequirement ServiceRequirement @relation(fields: [serviceRequirementId], references: [id])
  reviewedBy         User?              @relation("DocumentReviewer", fields: [reviewedById], references: [id])

  @@index([appointmentId, serviceRequirementId, isCurrent])
  @@index([status])
  @@index([aiStatus])
}

// ───────────────────── Background / audit ─────────────────────

model EmailLog {
  id            String        @id @default(uuid())
  userId        String?
  appointmentId String?
  toEmail       String
  template      EmailTemplate
  status        EmailStatus   @default(PENDING)
  attempts      Int           @default(0)
  error         String?
  sentAt        DateTime?
  createdAt     DateTime      @default(now())

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([appointmentId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String // e.g. "DOCUMENT_OVERRIDE", "APPOINTMENT_COMPLETED"
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
